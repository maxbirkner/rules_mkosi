package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

toolchain_type(
    name = "qemu_toolchain_type",
)

toolchain_type(
    name = "debian_tools_toolchain_type",
)

# Target platform for rules_mkosi's statically linked bootstrap executables. The default keeps the current
# platform; see //mkosi/private:bootstrap_binary.bzl.
label_flag(
    name = "bootstrap_platform",
    build_setting_default = ":inherit_platform",
)

# Sentinel value of bootstrap_platform that keeps the current platform.
filegroup(
    name = "inherit_platform",
    srcs = [],
)
