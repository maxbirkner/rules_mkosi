package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

toolchain_type(
    name = "qemu_toolchain_type",
)

toolchain_type(
    name = "debian_tools_toolchain_type",
)

# Target platform for rules_mkosi's statically linked bootstrap executables. The default builds them for
# //mkosi/toolchain/bootstrap_cc:linux_x86_64_musl and their runfiles for the current platform; see
# //mkosi/private:bootstrap_binary.bzl.
label_flag(
    name = "bootstrap_platform",
    build_setting_default = ":inherit_platform",
)

# Sentinel value of bootstrap_platform that builds the runfiles of the bootstrap executables for the current platform.
filegroup(
    name = "inherit_platform",
    srcs = [],
)

# First execution platform below rules_mkosi's bootstrap executables, so that the llvm toolchain's own helper tools are
# static musl executables too. It must be a Linux x86-64 platform with the llvm module's musl and non-PIE constraints.
# With remote execution, select a child of your execution platform that inherits its exec_properties; see the README.
label_flag(
    name = "bootstrap_execution_platform",
    build_setting_default = "//mkosi/toolchain/bootstrap_cc:linux_x86_64_musl",
)
