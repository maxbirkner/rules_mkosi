load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

exports_files([
    "defs.bzl",
    "debian_tools.bzl",
    "extensions.bzl",
    "qemu_toolchain.bzl",
    "qemu_versions.bzl",
    "toolchain.bzl",
    "versions.bzl",
    "version.bzl",
    "debian_tools.bzl",
])

alias(
    name = "kernel_preflight",
    actual = "//mkosi/private:kernel_preflight",
    visibility = ["//visibility:public"],
)

# Reference external signer for secure_boot_signing_manifest; see docs/secure-boot.md.
alias(
    name = "secure_boot_signer",
    actual = "//mkosi/private:secure_boot_signer",
    visibility = ["//visibility:public"],
)

# Reads the ESP manifest and other ESP files of a raw disk image; see docs/secure-boot.md.
alias(
    name = "esp_manifest",
    actual = "//mkosi/private/esp_manifest",
    visibility = ["//visibility:public"],
)

# The same reader as the Python module rules_mkosi_esp_manifest, a standalone stdlib-only script.
alias(
    name = "esp_manifest_lib",
    actual = "//mkosi/private/esp_manifest:esp_manifest_lib",
    visibility = ["//visibility:public"],
)

# Every Starlark file that the public API loads, for Stardoc and for consumers that document their own macros.
bzl_library(
    name = "bzl",
    srcs = glob(["*.bzl"]) + [
        "//mkosi/debian:bzl_srcs",
        "//mkosi/private:bzl_srcs",
    ],
    visibility = ["//visibility:public"],
)
