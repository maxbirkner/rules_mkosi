load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "debian13.spec.json",
    "debian13.lock.json",
    "provenance.bzl",
    "components.txt",
    "components_missing.txt",
    "extract_tree.py",
    "debian_launcher.py",
    "debian_tools_security_test.py",
    "debian_tools_lock_digest_test.py",
    "debian_python_hermetic_test.py",
    "launcher_main.cc",
    "namespace_runner.c",
    "package_archive.py",
])

py_binary(
    name = "generate_lock",
    srcs = ["generate_lock.py"],
    data = ["//mkosi/private:debian_control.py"],
    main = "generate_lock.py",
)

py_test(
    name = "generate_lock_test",
    srcs = [
        "generate_lock.py",
        "generate_lock_test.py",
    ],
    data = ["//mkosi/private:debian_control.py"],
    main = "generate_lock_test.py",
)

cc_library(
    name = "namespace_runner_source",
    testonly = True,
    textual_hdrs = ["namespace_runner.c"],
    visibility = ["//visibility:private"],
    deps = [
        "//mkosi/private:mount_api",
        "//mkosi/private:write_all",
    ],
)

cc_test(
    name = "namespace_runner_test",
    srcs = ["namespace_runner_test.c"],
    linkstatic = True,
    deps = [":namespace_runner_source"],
)

py_test(
    name = "debian_tools_security_test",
    srcs = [
        "debian_launcher.py",
        "debian_tools_security_test.py",
        "extract_tree.py",
        "package_archive.py",
    ],
    data = [
        "namespace_runner.c",
        "provenance.bzl",
        "@mkosi_debian_tools//:namespace_runner",
        "@mkosi_debian_tools//:tree",
    ],
    main = "debian_tools_security_test.py",
    deps = [
        "@mkosi_pypi//click",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "debian_tools_lock_digest_test",
    srcs = [
        "debian_tools_lock_digest_test.py",
    ],
    data = [
        "debian13.lock.json",
        "provenance.bzl",
        "@mkosi_debian_package_inputs//:package_manifest.txt",
    ],
    main = "debian_tools_lock_digest_test.py",
)

py_test(
    name = "debian_launcher_cli_test",
    srcs = [
        "debian_launcher.py",
        "debian_launcher_cli_test.py",
    ],
    main = "debian_launcher_cli_test.py",
    deps = [
        "@mkosi_pypi//click",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "debian_python_hermetic_test",
    srcs = ["debian_python_hermetic_test.py"],
    data = [
        "@mkosi_debian_python//:python",
        "@mkosi_debian_tools//:launcher",
        "@mkosi_debian_tools//:namespace_runner",
    ],
)

py_test(
    name = "extract_tree_security_test",
    srcs = [
        "extract_tree.py",
        "extract_tree_test.py",
    ],
    main = "extract_tree_test.py",
)
