"""Bzlmod extension for the pinned Debian userspace tree."""

load(
    "//mkosi/debian:provenance.bzl",
    "DEBIAN_TOOLS_ARCHIVE_SHA256",
    "DEBIAN_TOOLS_LOCK_SHA256",
    "DEBIAN_TOOLS_PYTHON_VERSION",
    "DEBIAN_TOOLS_REQUIRED_COMPONENTS",
)
load("//mkosi/private:debian_package_repo.bzl", "debian_package_repo")
load("//mkosi/private:debian_python_repo.bzl", "debian_python_repo")
load("//mkosi/private:debian_snapshot_repo.bzl", "debian_snapshot_repo")
load("//mkosi/private:debian_tools_repo.bzl", "debian_tools_repo")

_toolchain = tag_class(
    attrs = {},
)

_snapshot = tag_class(
    doc = """Declares an authenticated Debian snapshot repository from a consumer-owned lock.

The repository named `name` provides `//:repository` with `DebianSnapshotInfo`
for `mkosi_image(mode = "release", debian_snapshot = ...)`. Generate the lock
with the `<name>.update` target of a `debian_lock` macro or with
`bazel run @rules_mkosi//mkosi/debian:generate_lock`.
""",
    attrs = {
        "lock": attr.label(
            mandatory = True,
            allow_single_file = [".json"],
            doc = "Debian snapshot lock generated by //mkosi/debian:generate_lock.",
        ),
        "lock_sha256": attr.string(
            doc = "Optional expected SHA-256 of `lock`; the computed digest is always recorded in DebianSnapshotInfo.",
        ),
        "name": attr.string(
            mandatory = True,
            doc = "Apparent repository name; an internal `<name>_packages` repository is also created.",
        ),
    },
)

_BUILTIN_REPOSITORIES = [
    "mkosi_debian_package_inputs",
    "mkosi_debian_python",
    "mkosi_debian_snapshot",
    "mkosi_debian_tools",
]
_NAME_CHARACTERS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"

def snapshot_declaration_error(declarations):
    """Validates consumer snapshot declarations.

    Args:
      declarations: List of `(module_name, name, lock_sha256)` tuples in module
        resolution order.

    Returns:
      An empty string when every declaration is valid, otherwise the first
      error message.
    """
    owners = {name: "rules_mkosi" for name in _BUILTIN_REPOSITORIES}
    for module_name, name, lock_sha256 in declarations:
        if not name or not name[0].isalpha() or name.strip(_NAME_CHARACTERS) != "":
            return "debian_tools.snapshot name must be a valid repository name: %r" % name
        for repository in [name, name + "_packages"]:
            if repository in owners:
                return "debian_tools.snapshot repository %s requested by %s is already declared by %s" % (
                    repository,
                    module_name,
                    owners[repository],
                )
            owners[repository] = module_name
        if lock_sha256 and (len(lock_sha256) != 64 or lock_sha256.strip("0123456789abcdef") != ""):
            return "debian_tools.snapshot lock_sha256 must be a lowercase SHA-256: %s" % name
    return ""

def _snapshot_repositories(module_ctx):
    snapshots = []
    declarations = []
    for module in module_ctx.modules:
        for tag in module.tags.snapshot:
            snapshots.append(tag)
            declarations.append((module.name, tag.name, tag.lock_sha256))
    error = snapshot_declaration_error(declarations)
    if error:
        fail(error)
    return snapshots

def _debian_tools_impl(module_ctx):
    snapshots = _snapshot_repositories(module_ctx)
    debian_package_repo(
        name = "mkosi_debian_package_inputs",
        lock = "@rules_mkosi//mkosi/debian:debian13.lock.json",
    )
    debian_snapshot_repo(
        name = "mkosi_debian_snapshot",
        lock = "@rules_mkosi//mkosi/debian:debian13.lock.json",
        package_repo = "@mkosi_debian_package_inputs",
        lock_sha256 = DEBIAN_TOOLS_LOCK_SHA256,
    )
    for snapshot in snapshots:
        debian_package_repo(
            name = snapshot.name + "_packages",
            lock = snapshot.lock,
        )
        debian_snapshot_repo(
            name = snapshot.name,
            lock = snapshot.lock,
            package_repo = "@" + snapshot.name + "_packages",
            lock_sha256 = snapshot.lock_sha256,
        )
    debian_python_repo(name = "mkosi_debian_python")
    debian_tools_repo(
        name = "mkosi_debian_tools",
        package_repo = "@mkosi_debian_package_inputs",
        provenance = "@rules_mkosi//mkosi/debian:provenance.bzl",
        components = "@rules_mkosi//mkosi/debian:components.txt",
        required_components = DEBIAN_TOOLS_REQUIRED_COMPONENTS,
        lock_sha256 = DEBIAN_TOOLS_LOCK_SHA256,
        archive_sha256 = DEBIAN_TOOLS_ARCHIVE_SHA256,
        python_version = DEBIAN_TOOLS_PYTHON_VERSION,
    )
    return module_ctx.extension_metadata(reproducible = True)

debian_tools = module_extension(
    implementation = _debian_tools_impl,
    tag_classes = {
        "snapshot": _snapshot,
        "toolchain": _toolchain,
    },
    arch_dependent = False,
    os_dependent = True,
)
