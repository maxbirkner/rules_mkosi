load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//mkosi:toolchain.bzl", "managed_python_tool")
load("//mkosi:versions.bzl", "DEFAULT_PYTHON_VERSION")

package(default_visibility = ["//visibility:private"])

exports_files([
    "reproducibility_manifest.py",
    "boot_test.py",
    "bootstrap_binary.bzl",
    "diagnostics.py",
    "managed_python_bootstrap.py",
    "mkosi_image.bzl",
    "gpt_partitions.py",
    "partition_metadata.py",
    "uki_metadata.py",
    "verity_metadata.py",
    "managed_python_test.bzl",
    "qemu_ovmf_boot_test.bzl",
    "qemu_seabios_boot_test.bzl",
    "run_mkosi.py",
    "secure_boot.bzl",
    "secure_boot.py",
    "sibling_loader.py",
    "image_identity.bzl",
    "image_version.py",
    "sysupdate.bzl",
    "sysupdate.py",
    "stage_inputs.py",
    "write_bios_repart.py",
    "qemu_accelerator.bzl",
    "qemu_ovmf_validate.sh",
    "qemu_ovmf_smoke_test.bzl",
    "toolchains_repo.bzl",
    "debian_tools_repo.bzl",
    "debian_snapshot.bzl",
    "debian_snapshot_repo.bzl",
    "debian_snapshot.py",
])

# Modules that run_mkosi.py loads from its own directory.
filegroup(
    name = "run_mkosi_modules",
    srcs = [
        "mkosi_runner/__init__.py",
        "mkosi_runner/command_line.py",
        "mkosi_runner/release_patches.py",
        "mkosi_runner/release_sandbox.py",
        "mkosi_runner/release_validation.py",
        "mkosi_runner/tree.py",
    ],
    visibility = ["//visibility:public"],
)

# Interpreter for managed_python_test, resolved for rules_mkosi's Python line.
managed_python_tool(
    name = "managed_python",
    python_version = DEFAULT_PYTHON_VERSION,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "kernel_preflight_lib",
    srcs = ["kernel_preflight.c"],
    hdrs = ["kernel_preflight.h"],
    copts = ["-fPIC"],
)

cc_binary(
    name = "kernel_preflight",
    srcs = ["kernel_preflight_main.c"],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [":kernel_preflight_lib"],
)

cc_test(
    name = "kernel_preflight_test",
    srcs = ["kernel_preflight_test.c"],
    linkstatic = True,
    deps = [":kernel_preflight_lib"],
)

cc_test(
    name = "kernel_preflight_host_test",
    srcs = ["kernel_preflight_host_test.c"],
    linkstatic = True,
    tags = ["requires_kernel_contract"],
    deps = [":kernel_preflight_lib"],
)
