load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")
load("//mkosi:toolchain.bzl", "managed_python_tool")
load("//mkosi:versions.bzl", "DEFAULT_PYTHON_VERSION")
load(":c_options.bzl", "C_WARNINGS")

package(default_visibility = ["//visibility:private"])

exports_files([
    "reproducibility_manifest.py",
    "boot_test.py",
    "bootstrap_binary.bzl",
    "c_options.bzl",
    "config_tree.bzl",
    "debian_control.py",
    "diagnostics.py",
    "file_hashing.py",
    "managed_python_bootstrap.py",
    "image_metadata.bzl",
    "mkosi_action.bzl",
    "mkosi_image.bzl",
    "python_action.bzl",
    "qemu_boot_test.bzl",
    "staging.bzl",
    "gpt_partitions.py",
    "partition_metadata.py",
    "uki_metadata.py",
    "verity_metadata.py",
    "managed_python_test.bzl",
    "qemu_ovmf_boot_test.bzl",
    "qemu_seabios_boot_test.bzl",
    "run_mkosi.py",
    "secure_boot.bzl",
    "secure_boot.py",
    "efi_auth.py",
    "esp_files.py",
    "secure_boot_image.py",
    "secure_boot_signer.py",
    "launcher_tool.py",
    "sibling_loader.py",
    "image_identity.bzl",
    "image_version.py",
    "sysupdate.bzl",
    "sysupdate.py",
    "sysupdate_signing.bzl",
    "sysupdate_signing.py",
    "openpgp.py",
    "http_share.py",
    "stage_inputs.py",
    "write_bios_repart.py",
    "qemu_accelerator.bzl",
    "qemu_ovmf_validate.sh",
    "qemu_ovmf_smoke_test.bzl",
    "toolchains_repo.bzl",
    "ovmf_secure_boot_repo.bzl",
    "debian_tools_repo.bzl",
    "debian_snapshot.bzl",
    "debian_snapshot_repo.bzl",
    "debian_snapshot.py",
])

# Modules that run_mkosi.py loads from its own directory.
filegroup(
    name = "run_mkosi_modules",
    srcs = [
        "mkosi_runner/__init__.py",
        "mkosi_runner/command_line.py",
        "mkosi_runner/mkosi_contract.py",
        "mkosi_runner/mkosi_options.py",
        "mkosi_runner/network_sandbox.py",
        "mkosi_runner/release_patches.py",
        "mkosi_runner/release_sandbox.py",
        "mkosi_runner/release_validation.py",
        "mkosi_runner/repart_definitions.py",
        "mkosi_runner/tree.py",
    ],
    visibility = ["//visibility:public"],
)

# Reference external signer for secure_boot_signing_manifest; public as //mkosi:secure_boot_signer.
py_binary(
    name = "secure_boot_signer",
    srcs = ["secure_boot_signer.py"],
    args = [
        "--debian-tools",
        "$(rlocationpath @mkosi_debian_tools//:launcher)",
    ],
    data = [
        "efi_auth.py",
        "esp_files.py",
        "file_hashing.py",
        "gpt_partitions.py",
        "launcher_tool.py",
        "secure_boot.py",
        "sibling_loader.py",
        "@mkosi_debian_tools//:launcher",
    ],
    python_version = DEFAULT_PYTHON_VERSION,
    visibility = ["//mkosi:__pkg__"],
    deps = ["@rules_python//python/runfiles"],
)

# Interpreter for managed_python_test, resolved for rules_mkosi's Python line.
managed_python_tool(
    name = "managed_python",
    python_version = DEFAULT_PYTHON_VERSION,
    visibility = ["//visibility:public"],
)

# Shared by the kernel preflight and the Debian tools namespace runner.
cc_library(
    name = "mount_api",
    hdrs = ["mount_api.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "write_all",
    srcs = ["write_all.c"],
    hdrs = ["write_all.h"],
    copts = C_WARNINGS + ["-fPIC"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "write_all_test",
    srcs = ["write_all_test.c"],
    copts = C_WARNINGS,
    linkstatic = True,
    deps = [":write_all"],
)

cc_library(
    name = "kernel_preflight_lib",
    srcs = ["kernel_preflight.c"],
    hdrs = ["kernel_preflight.h"],
    copts = C_WARNINGS + ["-fPIC"],
    deps = [
        ":mount_api",
        ":write_all",
    ],
)

cc_binary(
    name = "kernel_preflight",
    srcs = ["kernel_preflight_main.c"],
    copts = C_WARNINGS,
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [":kernel_preflight_lib"],
)

cc_test(
    name = "kernel_preflight_test",
    srcs = ["kernel_preflight_test.c"],
    copts = C_WARNINGS,
    linkstatic = True,
    deps = [":kernel_preflight_lib"],
)

cc_test(
    name = "kernel_preflight_host_test",
    srcs = ["kernel_preflight_host_test.c"],
    copts = C_WARNINGS,
    linkstatic = True,
    tags = ["requires_kernel_contract"],
    deps = [":kernel_preflight_lib"],
)

filegroup(
    name = "bzl_srcs",
    srcs = glob(["*.bzl"]),
    visibility = ["//mkosi:__pkg__"],
)
