# arm64 images built from the built-in arm64 Debian snapshot. On a Linux x86-64 execution platform they are cross-built:
# the image's maintainer scripts run under the Debian tools toolchain's user-mode emulator.
load("@rules_python//python:defs.bzl", "py_test")
load(
    "//mkosi:defs.bzl",
    "mkosi_base",
    "mkosi_config_tree",
    "mkosi_image",
    "mkosi_reproducibility_manifest",
    "qemu_ovmf_boot_config",
    "qemu_ovmf_boot_test",
    "sysupdate_payload",
    "sysupdate_transfers",
)
load("//mkosi/tests:analysis_test_helpers.bzl", "expected_failure_test")
load("//mkosi/tests:mkosi_image_test.bzl", "image_field_file", "raw_image_file")
load(":arm64_test.bzl", "arm64_boot_config_test", "arm64_image_test", "foreign_architecture_test")

package(default_visibility = ["//mkosi/tests:__subpackages__"])

mkosi_config_tree(
    name = "minimal_config",
    src = "minimal-config",
)

mkosi_image(
    name = "minimal",
    config_tree = ":minimal_config",
    debian_snapshot = "@mkosi_debian_snapshot_arm64//:repository",
)

raw_image_file(
    name = "minimal_raw",
    image = ":minimal",
)

py_test(
    name = "minimal_artifact_test",
    srcs = [
        "arm64_image_artifact_test.py",
        "//mkosi/tests:release_root.py",
        "//mkosi/tests:runfile_paths.py",
    ],
    args = [
        "$(rootpath :minimal_raw)",
        "$(rootpath //mkosi/debian:launcher)",
    ],
    data = [
        ":minimal_raw",
        "//mkosi/debian:launcher",
    ],
    main = "arm64_image_artifact_test.py",
    deps = ["@rules_python//python/runfiles"],
)

foreign_architecture_test(
    name = "minimal_foreign_architecture_test",
    mnemonic = "MkosiImage",
    target_under_test = ":minimal",
)

mkosi_base(
    name = "base_subject",
    config_tree = ":minimal_config",
    debian_snapshot = "@mkosi_debian_snapshot_arm64//:repository",
    release_seed = "00000000-0000-4000-8000-000000000206",
    release_source_date_epoch = 0,
    tags = ["manual"],
)

foreign_architecture_test(
    name = "base_foreign_architecture_test",
    mnemonic = "MkosiBase",
    target_under_test = ":base_subject",
)

mkosi_config_tree(
    name = "release_config",
    srcs = glob(["release-config/**"]),
    strip_prefix = "release-config",
)

sysupdate_transfers(
    name = "transfers",
    architecture = "arm64",
    image_id = "rules-mkosi-arm64",
)

# The reusable arm64 release fixture: a UKI, a dm-verity protected erofs root, and A/B slots.
mkosi_image(
    name = "uki_release",
    config_tree = ":release_config",
    debian_snapshot = "@mkosi_debian_snapshot_arm64//:repository",
    image_id = "rules-mkosi-arm64",
    image_version = "1",
    mode = "release",
    release_seed = "00000000-0000-4000-8000-000000000206",
    release_source_date_epoch = 1789200491,
    rootfs_payloads = [":transfers"],
    unified_kernel_image = "unsigned",
    verity = "hash",
)

sysupdate_payload(
    name = "uki_release_payload",
    image = ":uki_release",
)

mkosi_reproducibility_manifest(
    name = "uki_release_reproducibility",
    image = ":uki_release",
)

arm64_image_test(
    name = "uki_release_provider_test",
    target_under_test = ":uki_release",
)

[
    image_field_file(
        name = "uki_release_" + field,
        field = field,
        image = ":uki_release",
    )
    for field in ("raw_image", "partition_metadata", "uki")
]

py_test(
    name = "uki_release_artifact_test",
    srcs = [
        "arm64_release_artifact_test.py",
        "//mkosi/tests:runfile_paths.py",
    ],
    args = [
        "$(rootpath :uki_release_raw_image)",
        "$(rootpath :uki_release_partition_metadata)",
        "$(rootpath :uki_release_uki)",
        "$(rootpath :uki_release_payload)",
    ],
    data = [
        ":uki_release_partition_metadata",
        ":uki_release_payload",
        ":uki_release_raw_image",
        ":uki_release_uki",
    ],
    main = "arm64_release_artifact_test.py",
    deps = [
        "//mkosi:esp_manifest_lib",
        "@rules_python//python/runfiles",
    ],
)

# On Linux x86-64 the arm64 guest runs under TCG.
qemu_ovmf_boot_test(
    name = "uki_release_boot_test",
    image = ":uki_release",
    # Only the root file system's systemd logs it, after the switch from the initrd.
    readiness_marker = "systemd[1]: Detected first boot.",
)

arm64_boot_config_test(
    name = "uki_release_boot_config_test",
    target_under_test = ":uki_release_boot_test_config",
)

# Analysis only: there is no pinned Secure Boot firmware for arm64 guests.
qemu_ovmf_boot_config(
    name = "uki_release_secure_boot_config",
    testonly = True,
    image = ":uki_release",
    secure_boot_code = "release-config/README.md",
    secure_boot_vars = "release-config/README.md",
    tags = ["manual"],
)

expected_failure_test(
    name = "uki_release_secure_boot_rejected_test",
    expected_error = "secure_boot = True boots only amd64 images",
    target_under_test = ":uki_release_secure_boot_config",
)
