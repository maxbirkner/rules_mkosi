# arm64 images built from the built-in arm64 Debian snapshot. On a Linux x86-64 execution platform they are cross-built:
# the image's maintainer scripts run under the Debian tools toolchain's user-mode emulator.
load("@rules_python//python:defs.bzl", "py_test")
load("//mkosi:defs.bzl", "mkosi_base", "mkosi_config_tree", "mkosi_image")
load("//mkosi/tests:mkosi_image_test.bzl", "raw_image_file")
load(":arm64_test.bzl", "foreign_architecture_test")

package(default_visibility = ["//mkosi/tests:__subpackages__"])

mkosi_config_tree(
    name = "minimal_config",
    src = "minimal-config",
)

mkosi_image(
    name = "minimal",
    config_tree = ":minimal_config",
    debian_snapshot = "@mkosi_debian_snapshot_arm64//:repository",
)

raw_image_file(
    name = "minimal_raw",
    image = ":minimal",
)

py_test(
    name = "minimal_artifact_test",
    srcs = [
        "arm64_image_artifact_test.py",
        "//mkosi/tests:release_root.py",
        "//mkosi/tests:runfile_paths.py",
    ],
    args = [
        "$(rootpath :minimal_raw)",
        "$(rootpath @mkosi_debian_tools//:launcher)",
    ],
    data = [
        ":minimal_raw",
        "@mkosi_debian_tools//:launcher",
    ],
    main = "arm64_image_artifact_test.py",
    deps = ["@rules_python//python/runfiles"],
)

foreign_architecture_test(
    name = "minimal_foreign_architecture_test",
    mnemonic = "MkosiImage",
    target_under_test = ":minimal",
)

mkosi_base(
    name = "base_subject",
    config_tree = ":minimal_config",
    debian_snapshot = "@mkosi_debian_snapshot_arm64//:repository",
    release_seed = "00000000-0000-4000-8000-000000000206",
    release_source_date_epoch = 0,
    tags = ["manual"],
)

foreign_architecture_test(
    name = "base_foreign_architecture_test",
    mnemonic = "MkosiBase",
    target_under_test = ":base_subject",
)
