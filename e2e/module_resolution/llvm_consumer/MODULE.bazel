module(name = "mkosi_llvm_consumer")

bazel_dep(name = "rules_mkosi", version = "0.0.0")
local_path_override(
    module_name = "rules_mkosi",
    path = "../../..",
)

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_shell", version = "0.8.0")

# The consumer pins the llvm module, which rules_mkosi's bootstrap executables also build with, at a newer version
# than rules_mkosi requires, and registers all of its toolchains for its own C/C++ targets. Registered by the root
# module, they precede every toolchain of its dependencies and, for the host platform, target glibc.
bazel_dep(name = "llvm", version = "0.8.18")
single_version_override(
    module_name = "llvm",
    version = "0.8.18",
)

register_toolchains("@llvm//toolchain:all")

debian_tools = use_extension("@rules_mkosi//mkosi/debian:extensions.bzl", "debian_tools")
use_repo(debian_tools, "mkosi_debian_tools")
