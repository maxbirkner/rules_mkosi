module(name = "mkosi_consumer_isolation")

bazel_dep(name = "rules_mkosi", version = "0.0.0")
local_path_override(
    module_name = "rules_mkosi",
    path = "../../..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# The consumer depends on rules_python itself for its own Python toolchain.
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

hermetic_cc = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
)
use_repo(hermetic_cc, "zig_sdk")

# The consumer's preferred C/C++ toolchain targets glibc and cannot link fully static executables. Registered first,
# it wins for every target platform without an explicit libc constraint, but not for rules_mkosi's bootstrap
# executables, which resolve rules_mkosi's static toolchains first.
register_toolchains("@zig_sdk//toolchain:linux_amd64_gnu.2.31")

# The consumer's default Python line differs from rules_mkosi's.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.13")
python.toolchain(python_version = "3.13")

mkosi = use_extension("@rules_mkosi//mkosi:extensions.bzl", "mkosi")
mkosi.toolchain()
use_repo(mkosi, "mkosi_toolchains")

debian_tools = use_extension("@rules_mkosi//mkosi/debian:extensions.bzl", "debian_tools")
debian_tools.toolchain()
use_repo(debian_tools, "mkosi_debian_tools")

register_toolchains(
    "@mkosi_toolchains//:all",
    "@mkosi_debian_tools//:linux_x86_64",
)
