#!/bin/sh
# Drives the A/B lifecycle test from inside the guest. The host test checks the
# serial markers printed here and the final poweroff.
set -eu

marker() {
    echo "rules-mkosi-ab: $*"
}

# The test signs the payloads' SHA256SUMS with a throwaway key, which the image
# cannot contain, and shares its certificate. A production image ships its
# signer's certificate as /etc/systemd/import-pubring.gpg instead.
trust_test_signer() {
    mkdir -p /run/test-keyring
    mount -t 9p -o trans=virtio,version=9p2000.L,ro keyring /run/test-keyring
    mount --bind /run/test-keyring/import-pubring.gpg /usr/lib/systemd/import-pubring.gpg
}

# The transfers download release N+1 from http://10.0.2.100/after-N over HTTP
# and verify the signature of its SHA256SUMS.
install_release() {
    trust_test_signer
    /usr/lib/systemd/systemd-networkd-wait-online --timeout=60
    # Log to the serial console rather than only to the journal.
    SYSTEMD_LOG_TARGET=console /usr/lib/systemd/systemd-sysupdate update
    # A new UKI starts with boot counting enabled.
    for uki in "${esp}/EFI/Linux/${IMAGE_ID}_$1+"*.efi; do
        [ -e "${uki}" ] || {
            marker "release $1 was not installed"
            exit 1
        }
    done
    marker "installed $1"
    systemctl reboot --no-block
}

# shellcheck source=/dev/null # os-release only exists inside the guest image.
. /usr/lib/os-release
esp=$(bootctl --print-esp-path)
roothash=
read -r cmdline < /proc/cmdline
for argument in ${cmdline}; do
    case "${argument}" in
    roothash=*) roothash="${argument#roothash=}" ;;
    esac
done
marker "running ${IMAGE_VERSION} from $(findmnt --noheadings --output FSTYPE /) with roothash ${roothash}"
# The last byte of an EFI variable file is the value after its four attribute bytes.
efi_global_variable() {
    od -An -tu1 -j4 -N1 "/sys/firmware/efi/efivars/$1-8be4df61-93ca-11d2-aa0d-00e098032b8c" 2>/dev/null | tr -d ' ' || true
}
marker "SecureBoot=$(efi_global_variable SecureBoot) SetupMode=$(efi_global_variable SetupMode)"

case "${IMAGE_VERSION}" in
1)
    install_release 2
    ;;
2)
    if [ -e "${esp}/EFI/Linux/${IMAGE_ID}_3+0-1.efi" ] && [ -e "${esp}/EFI/Linux/${IMAGE_ID}_2.efi" ]; then
        marker "rolled back from 3 to 2"
        systemctl poweroff --no-block
    elif [ -e "${esp}/EFI/Linux/${IMAGE_ID}_2.efi" ]; then
        marker "2 is blessed"
        install_release 3
    else
        marker "2 is not blessed"
        exit 1
    fi
    ;;
*)
    marker "unexpected version ${IMAGE_VERSION}"
    exit 1
    ;;
esac
