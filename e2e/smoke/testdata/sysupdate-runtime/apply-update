#!/bin/sh
set -eu
fail() {
    status=$?
    echo "RULES_MKOSI_UPDATER_FAILURE status=$status"
    systemctl --no-block poweroff
    exit "$status"
}
trap fail EXIT
echo RULES_MKOSI_SLOT_A_VERSION=1
echo RULES_MKOSI_UPDATER_START
mkdir -p /run/rules-mkosi-update
modprobe 9pnet_virtio || echo RULES_MKOSI_9P_TRANSPORT_BUILTIN
echo RULES_MKOSI_PAYLOAD_MOUNT_START
mount -v -t 9p -o trans=virtio,version=9p2000.L,ro rules_mkosi_updates /run/rules-mkosi-update
echo RULES_MKOSI_PAYLOAD_MOUNT_COMPLETE
cd /run/rules-mkosi-update/source
sha256sum -c SHA256SUMS
echo RULES_MKOSI_UPDATE_DIGESTS_VERIFIED
/usr/lib/systemd/systemd-sysupdate --definitions=/run/rules-mkosi-update/definitions --transfer-source=/run/rules-mkosi-update/source --verify=yes update 2
echo RULES_MKOSI_SYSUPDATE_APPLIED_VERSION=2
touch /efi/rules-mkosi-update-applied
sync
trap - EXIT
systemctl poweroff
