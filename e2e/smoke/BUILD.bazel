load("@bazel_skylib//rules:build_test.bzl", "build_test")
load(
    "@rules_mkosi//mkosi:defs.bzl",
    "managed_python_test",
    "mkosi_config_tree",
    "mkosi_image",
    "mkosi_source_tree",
    "qemu_ovmf_boot_test",
    "qemu_ovmf_smoke_test",
)
load("@rules_python//python:defs.bzl", "py_runtime", "py_runtime_pair", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    ":public_api_test.bzl",
    "image_build_metadata_file",
    "image_public_api_test",
    "mkosi_python_override_test",
    "public_api_test",
    "raw_image_file",
    "snapshot_public_api_test",
)
load(":python_override.bzl", "consumer_python")

consumer_python(
    name = "consumer_python",
    interpreter = "@python_3_14//:python3",
    runtime = "@python_3_14//:files",
)

py_runtime(
    name = "consumer_python_runtime",
    files = [":consumer_python"],
    interpreter = ":consumer_python",
    interpreter_version_info = {
        "major": "3",
        "micro": "0",
        "minor": "14",
    },
    python_version = "PY3",
)

py_runtime_pair(
    name = "consumer_python_runtime_pair",
    py3_runtime = ":consumer_python_runtime",
)

toolchain(
    name = "consumer_python_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":consumer_python_runtime_pair",
    toolchain_type = "@rules_python//python:toolchain_type",
)

mkosi_image(
    name = "demo",
    config = "testdata/minimal.conf",
    tags = ["requires-network"],
)

mkosi_image(
    name = "tree_demo",
    config_tree = ":config_tree",
    source_trees = {
        "src": ":source_tree",
    },
    tags = ["requires-network"],
)

mkosi_config_tree(
    name = "config_tree",
    src = "@rules_mkosi//mkosi/tests:testdata/config-tree",
)

mkosi_source_tree(
    name = "source_tree",
    src = "@rules_mkosi//mkosi/tests:testdata/source-tree",
    executable_paths = ["mkosi.build"],
)

build_test(
    name = "demo_build_test",
    tags = ["requires-network"],
    targets = [":demo"],
)

build_test(
    name = "tree_demo_build_test",
    tags = ["requires-network"],
    targets = [":tree_demo"],
)

public_api_test(
    name = "debian_tools_public_provider_test",
    target_under_test = "@mkosi_debian_tools//:toolchain",
)

mkosi_python_override_test(
    name = "mkosi_python_override_test",
    target_under_test = "@mkosi_toolchains//:mkosi_toolchain",
)

snapshot_public_api_test(
    name = "debian_snapshot_public_provider_test",
    target_under_test = "@mkosi_debian_snapshot//:repository",
)

snapshot_public_api_test(
    name = "debian_snapshot_second_consumer_test",
    target_under_test = "@mkosi_debian_snapshot//:repository",
)

image_public_api_test(
    name = "image_public_provider_test",
    target_under_test = ":demo",
)

image_build_metadata_file(
    name = "demo_build_metadata",
    image = ":demo",
)

raw_image_file(
    name = "demo_raw",
    image = ":demo",
)

raw_image_file(
    name = "tree_demo_raw",
    image = ":tree_demo",
)

py_test(
    name = "demo_build_metadata_test",
    srcs = ["image_metadata_test.py"],
    args = ["$(rootpath :demo_build_metadata)"],
    data = [":demo_build_metadata"],
    main = "image_metadata_test.py",
)

qemu_ovmf_boot_test(
    name = "demo_boot_test",
    image = ":demo",
    tags = [
        "manifest",
        "requires-network",
    ],
)

managed_python_test(
    name = "boot_launcher_contract_test",
    src = "launcher_contract.py",
    args = ["$(rootpath @mkosi_toolchains//:mkosi_python)"],
    data = [
        "launcher_contract.py",
        "@mkosi_toolchains//:mkosi_python",
    ],
    tags = ["manifest"],
)

sh_test(
    name = "boot_entry_regression_test",
    srcs = ["boot_entry_regression.sh"],
    args = [
        "$(rootpath @mkosi_toolchains//:mkosi_python)",
        "$(rootpath @rules_mkosi//mkosi/private:managed_python_bootstrap.py)",
        "$(rootpath @rules_mkosi//mkosi/private:boot_test.py)",
        "$(rootpath testdata/invalid_boot_config.json)",
    ],
    data = [
        "launcher_contract.py",
        "testdata/invalid_boot_config.json",
        "@mkosi_toolchains//:mkosi_python",
        "@rules_mkosi//mkosi/private:boot_test.py",
        "@rules_mkosi//mkosi/private:managed_python_bootstrap.py",
    ],
)

build_test(
    name = "kernel_preflight_build_test",
    targets = ["@rules_mkosi//mkosi:kernel_preflight"],
)

build_test(
    name = "debian_tools_public_api_test",
    targets = [
        "@mkosi_debian_tools//:launcher",
        "@mkosi_debian_tools//:toolchain",
    ],
)

sh_test(
    name = "mkosi_version_test",
    srcs = ["@rules_mkosi//mkosi/tests:mkosi_version_test.sh"],
    args = [
        "$(rootpath @mkosi_toolchains//:mkosi_python)",
        "$(rootpath @mkosi_toolchains//:mkosi_script)",
    ],
    data = [
        "sitecustomize.py",
        "@mkosi_toolchains//:mkosi_python",
        "@mkosi_toolchains//:mkosi_runfiles",
        "@mkosi_toolchains//:mkosi_runtime",
        "@mkosi_toolchains//:mkosi_script",
    ],
)

qemu_ovmf_smoke_test(
    name = "qemu_ovmf_smoke_test",
)

sh_test(
    name = "demo_artifact_test",
    srcs = ["raw_image_validator_test.sh"],
    args = [
        "$(rootpath :demo_raw)",
        "$(rootpath raw_image_validator.py)",
        "$(rootpath @mkosi_debian_python//:python)",
    ],
    data = [
        "raw_image_validator.py",
        ":demo_raw",
        "@mkosi_debian_python//:python",
    ],
)

sh_test(
    name = "raw_image_validator_test",
    srcs = ["raw_image_validator_unit_test.sh"],
    args = [
        "$(rootpath raw_image_validator_test.py)",
        "$(rootpath @mkosi_debian_python//:python)",
    ],
    data = [
        "raw_image_validator.py",
        "raw_image_validator_test.py",
        "@mkosi_debian_python//:python",
    ],
)

sh_test(
    name = "raw_image_corruption_test",
    srcs = ["raw_image_corruption_test.sh"],
    args = [
        "$(rootpath raw_image_corruption_test.py)",
        "$(rootpath @mkosi_debian_python//:python)",
        "$(rootpath :demo_raw)",
    ],
    data = [
        "raw_image_corruption_test.py",
        "raw_image_validator.py",
        ":demo_raw",
        "@mkosi_debian_python//:python",
    ],
    tags = ["requires-network"],
)

sh_test(
    name = "mkosi_config_test",
    srcs = ["mkosi_config_test.sh"],
    args = ["$(rootpath testdata/minimal.conf)"],
    data = ["testdata/minimal.conf"],
)

py_test(
    name = "tree_demo_artifact_test",
    srcs = ["raw_image_validator.py"],
    args = ["$(rootpath :tree_demo_raw)"],
    data = [":tree_demo_raw"],
    main = "raw_image_validator.py",
    tags = ["requires-network"],
)

py_test(
    name = "tree_demo_semantics_test",
    srcs = ["staged_image_semantics_test.py"],
    args = ["$(rootpath :tree_demo_raw)"],
    data = [":tree_demo_raw"],
    main = "staged_image_semantics_test.py",
    tags = ["requires-network"],
)
