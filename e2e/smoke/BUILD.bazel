load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_mkosi//mkosi:defs.bzl", "mkosi_image", "qemu_ovmf_smoke_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":public_api_test.bzl", "image_public_api_test", "public_api_test")

mkosi_image(
    name = "demo",
    config = "testdata/minimal.conf",
    tags = ["manual"],
)

build_test(
    name = "demo_build_test",
    tags = ["manual"],
    targets = [":demo"],
)

public_api_test(
    name = "debian_tools_public_provider_test",
    target_under_test = "@mkosi_debian_tools//:toolchain",
)

image_public_api_test(
    name = "image_public_provider_test",
    target_under_test = ":demo",
)

build_test(
    name = "kernel_preflight_build_test",
    targets = ["@rules_mkosi//mkosi:kernel_preflight"],
)

build_test(
    name = "debian_tools_public_api_test",
    targets = [
        "@mkosi_debian_tools//:launcher",
        "@mkosi_debian_tools//:toolchain",
    ],
)

sh_test(
    name = "mkosi_version_test",
    srcs = ["mkosi_version_test.sh"],
    args = [
        "$(rootpath @mkosi_toolchains//:mkosi_python)",
        "$(rootpath @mkosi_toolchains//:mkosi_script)",
    ],
    data = [
        "sitecustomize.py",
        "@mkosi_toolchains//:mkosi_python",
        "@mkosi_toolchains//:mkosi_runfiles",
        "@mkosi_toolchains//:mkosi_runtime",
        "@mkosi_toolchains//:mkosi_script",
    ],
)

qemu_ovmf_smoke_test(
    name = "qemu_ovmf_smoke_test",
)

sh_test(
    name = "demo_artifact_test",
    srcs = ["raw_image_validator_test.sh"],
    args = [
        "$(rootpath :demo)",
        "$(rootpath raw_image_validator.py)",
        "$(rootpath @mkosi_debian_python//:bin/python3.11)",
    ],
    data = [
        "raw_image_validator.py",
        ":demo",
        "@mkosi_debian_python//:bin/python3.11",
    ],
    tags = ["manual"],
)

sh_test(
    name = "raw_image_validator_test",
    srcs = ["raw_image_validator_unit_test.sh"],
    args = [
        "$(rootpath raw_image_validator_test.py)",
        "$(rootpath @mkosi_debian_python//:bin/python3.11)",
    ],
    data = [
        "raw_image_validator.py",
        "raw_image_validator_test.py",
        "@mkosi_debian_python//:bin/python3.11",
    ],
)

sh_test(
    name = "mkosi_config_test",
    srcs = ["mkosi_config_test.sh"],
    args = ["$(rootpath testdata/minimal.conf)"],
    data = ["testdata/minimal.conf"],
)
