#!/usr/bin/env bash
set -euo pipefail

module_root=$PWD
while [[ ! -f "$module_root/MODULE.bazel" ]]; do
    if [[ "$module_root" == / ]]; then
        echo "could not find a Bazel module root from $PWD" >&2
        exit 1
    fi
    module_root=${module_root%/*}
    [[ -n "$module_root" ]] || module_root=/
done

backend=
IFS=: read -r -a path_entries <<<"${PATH:-}"
for name in bazel bazelisk; do
    for path_entry in "${path_entries[@]}"; do
        [[ -n "$path_entry" ]] || path_entry=.
        candidate=$path_entry/$name
        if [[ -f "$candidate" && -x "$candidate" &&
              ! "$candidate" -ef "${BASH_SOURCE[0]}" ]]; then
            backend=$candidate
            break 2
        fi
    done
done
if [[ -z "$backend" ]]; then
    echo "could not find a Bazel or Bazelisk executable other than ${BASH_SOURCE[0]}" >&2
    exit 1
fi

case "${1:-}" in
    -h|--help|--version)
        exec "$backend" "$@"
        ;;
esac

cache=$module_root/.cache/bazel-disk
rc_directory=$module_root/.cache
rc=$rc_directory/bazel-wrapper.bazelrc
mkdir -p "$rc_directory"
rc_temporary=$rc.$BASHPID
trap 'rm -f "$rc_temporary"' EXIT
escaped_cache=${cache//\\/\\\\}
escaped_cache=${escaped_cache//\"/\\\"}
for command in build info query; do
    printf '%s --disk_cache="%s"\n' "$command" "$escaped_cache"
done >"$rc_temporary"
mv -f "$rc_temporary" "$rc"
trap - EXIT

exec "$backend" "--bazelrc=$rc" "$@"
