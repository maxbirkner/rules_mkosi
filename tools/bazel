#!/usr/bin/env bash
set -euo pipefail

module_root=$PWD
while [[ ! -f "$module_root/MODULE.bazel" ]]; do
    if [[ "$module_root" == / ]]; then
        echo "could not find a Bazel module root from $PWD" >&2
        exit 1
    fi
    module_root=${module_root%/*}
    [[ -n "$module_root" ]] || module_root=/
done

backend=
IFS=: read -r -a path_entries <<<"${PATH:-}"
for name in bazel bazelisk; do
    for path_entry in "${path_entries[@]}"; do
        [[ -n "$path_entry" ]] || path_entry=.
        candidate=$path_entry/$name
        if [[ -f "$candidate" && -x "$candidate" &&
              ! "$candidate" -ef "${BASH_SOURCE[0]}" ]]; then
            backend=$candidate
            break 2
        fi
    done
done
if [[ -z "$backend" ]]; then
    echo "could not find a Bazel or Bazelisk executable other than ${BASH_SOURCE[0]}" >&2
    exit 1
fi

args=("$@")
command_index=-1
for ((index = 0; index < ${#args[@]}; index++)); do
    argument=${args[index]}
    if [[ "$argument" == -- ]]; then
        break
    fi
    case "$argument" in
        --bazelrc|--connect_timeout_secs|--digest_function|--host_jvm_args|\
        --experimental_cgroup_parent|--extra_classpath|--failure_detail_out|\
        --io_nice_level|--local_startup_timeout_secs|--macos_qos_class|\
        --max_idle_secs|--output_base|--output_user_root|--server_javabase|\
        --server_jvm_out)
            ((index += 1))
            ;;
        -*)
            ;;
        *)
            command_index=$index
            break
            ;;
    esac
done

if ((command_index < 0)); then
    exec "$backend" "${args[@]}"
fi

command=${args[command_index]}
case "$command" in
    aquery|build|coverage|cquery|fetch|info|mobile-install|print_action|\
    query|run|sync|test)
        ;;
    *)
        exec "$backend" "${args[@]}"
        ;;
esac

disk_cache_supplied=0
for ((index = command_index + 1; index < ${#args[@]}; index++)); do
    argument=${args[index]}
    [[ "$argument" == -- ]] && break
    if [[ "$argument" == --disk_cache=* ]]; then
        disk_cache_supplied=1
        break
    fi
    if [[ "$argument" == --disk_cache ]] &&
       ((index + 1 < ${#args[@]})); then
        disk_cache_supplied=1
        break
    fi
done

if ((disk_cache_supplied)); then
    exec "$backend" "${args[@]}"
fi

cache=$module_root/.cache/bazel-disk
exec "$backend" \
    "${args[@]:0:command_index + 1}" \
    "--disk_cache=$cache" \
    "${args[@]:command_index + 1}"
