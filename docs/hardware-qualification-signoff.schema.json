{
  "$defs": {
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/maxbirkner/rules_mkosi/blob/main/docs/hardware-qualification-signoff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The hardware classes that one rules_mkosi release claims, with their attached results; see docs/hardware-qualification.md.",
  "properties": {
    "classes": {
      "items": {
        "additionalProperties": false,
        "if": {
          "properties": {
            "status": {
              "const": "qualified"
            }
          }
        },
        "properties": {
          "class": {
            "pattern": "^(uefi|bios)-[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "known_issues": {
            "items": {
              "format": "uri",
              "type": "string"
            },
            "type": "array"
          },
          "results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "asset": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "asset",
                "sha256"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "qualified",
              "failed",
              "not-tested"
            ]
          }
        },
        "required": [
          "class",
          "status",
          "results"
        ],
        "then": {
          "properties": {
            "results": {
              "minItems": 1
            }
          }
        },
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "format_version": {
      "const": "rules-mkosi-hardware-qualification-signoff-v1"
    },
    "release": {
      "additionalProperties": false,
      "properties": {
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "tag": {
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "commit",
        "archive_sha256"
      ],
      "type": "object"
    },
    "signed_off_at": {
      "format": "date-time",
      "type": "string"
    },
    "signed_off_by": {
      "minLength": 1,
      "type": "string"
    },
    "vm_gates": {
      "additionalProperties": false,
      "properties": {
        "ci_run": {
          "format": "uri",
          "type": "string"
        },
        "conclusion": {
          "const": "success"
        }
      },
      "required": [
        "ci_run",
        "conclusion"
      ],
      "type": "object"
    }
  },
  "required": [
    "format_version",
    "release",
    "vm_gates",
    "classes",
    "signed_off_by",
    "signed_off_at"
  ],
  "title": "rules_mkosi hardware qualification sign-off",
  "type": "object"
}
