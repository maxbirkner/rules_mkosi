# CI invokes //... directly. Configurations change execution semantics, not
# membership in a hand-maintained test inventory.
build:qualified_runtime --spawn_strategy=linux-sandbox
test:qualified_runtime --cache_test_results=no
test:qualified_runtime --spawn_strategy=linux-sandbox
test:qualified_runtime --test_output=all

common:qualified --config=qualified_runtime
test:qualified --test_tag_filters=-requires_kernel_contract
common:portable --config=qualified_runtime
build:portable --build_tag_filters=-requires-network
test:portable --test_tag_filters=-requires-network,-requires_kernel_contract
common:manifest --config=qualified_runtime
build:manifest --enable_runfiles=no
build:manifest --disk_cache=
test:manifest --enable_runfiles=no --test_strategy=exclusive
test:manifest --cache_test_results=no --disk_cache=
test:manifest --test_tag_filters=manifest

build:deterministic --noremote_accept_cached
build:deterministic --noremote_upload_local_results
build:deterministic --disk_cache=
build:deterministic --build_tag_filters=-requires-network

build:kernel_preflight --compilation_mode=opt
build:kernel_preflight --disk_cache=
build:kernel_preflight --build_tag_filters=requires_kernel_contract
build:kernel_preflight --noexperimental_use_hermetic_linux_sandbox
build:kernel_preflight --spawn_strategy=linux-sandbox
test:kernel_preflight --test_tag_filters=requires_kernel_contract
test:kernel_preflight --test_strategy=exclusive
test:kernel_preflight --test_output=all
test:kernel_preflight --cache_test_results=no

common:bazel9 --lockfile_mode=off
