#!/usr/bin/env bash
# Runs a command as the current user with an empty supplementary-group list.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: group-free COMMAND [ARGUMENT...]" >&2
  exit 2
fi

environment=(HOME="$HOME" PATH="$PATH" USER="$(id -un)")
if [[ -n "${USE_BAZEL_VERSION:-}" ]]; then
  environment+=(USE_BAZEL_VERSION="$USE_BAZEL_VERSION")
fi

# shellcheck disable=SC2016 # The inner script expands its own variables.
exec sudo -n setpriv --reuid="$(id -u)" --regid="$(id -g)" --clear-groups \
  env "${environment[@]}" sh -eu -c '
    while IFS= read -r line; do
      case "$line" in
        Groups:*[![:space:]]*)
          echo "group-free: supplementary groups were not cleared" >&2
          exit 1
          ;;
      esac
    done < /proc/self/status
    exec "$@"
  ' group-free "$@"
