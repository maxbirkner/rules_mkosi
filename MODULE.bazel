"""Bazel rules for building OS images with mkosi."""

module(
    name = "rules_mkosi",
    # rules_qemu 0.3.0 requires Bazel 7.7 or newer.  The checked-in lockfile
    # is generated by the 7.7.1 compatibility floor; newer Bazel versions use
    # lockfile formats that are intentionally exercised with lockfile mode off
    # in CI without rewriting this file.
    bazel_compatibility = [
        ">=7.7.0",
    ],
)

# Runtime dependencies. These are minimum versions for module resolution.
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_qemu", version = "0.3.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

hermetic_cc = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
hermetic_cc.exec_platform(
    arch = "amd64",
    os = "linux",
)
use_repo(hermetic_cc, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_musl",
    dev_dependency = True,
)

qemu = use_extension("@rules_qemu//qemu/extension:qemu.bzl", "qemu")
use_repo(
    qemu,
    "qemu_img_prebuilt_linux_amd64",
    "qemu_system_bin_prebuilt_linux_amd64_x86_64_softmmu",
    "qemu_system_data_prebuilt_linux_amd64",
    "qemu_system_toolchains",
    "qemu_user_toolchains",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11")
python.toolchain(python_version = "3.11")
use_repo(python, "python_3_11", "pythons_hub", python = "python_versions")

register_toolchains("@pythons_hub//:all")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mkosi_pypi",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "mkosi_pypi")

mkosi = use_extension("//mkosi:extensions.bzl", "mkosi")
mkosi.toolchain()
use_repo(mkosi, "mkosi_toolchains")

register_toolchains(
    "@mkosi_toolchains//:qemu_linux_x86_64",
    "@mkosi_toolchains//:all",
)

debian_tools = use_extension("//mkosi/debian:extensions.bzl", "debian_tools")
debian_tools.toolchain()
use_repo(
    debian_tools,
    "mkosi_debian_package_inputs",
    "mkosi_debian_python",
    "mkosi_debian_tools",
)

register_toolchains("@mkosi_debian_tools//:linux_x86_64")
